{
  "name": "loreal-routine-builder-project-09",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "INFERENCE_URL": "https://llm-api.danielnotes.stream/v1/chat/completions",
    "INFERENCE_MODEL": "inkling2-mini"
  }
}
